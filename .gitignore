# ─────────────────────────────────────────────────────────────
# Adaptive Emergency Triage Agent — .gitignore
# ─────────────────────────────────────────────────────────────

# ══════════════════════════════════════
#  SECRETS — NEVER COMMIT THESE
# ══════════════════════════════════════
.env
.env.local
.env.production
.env.staging
.env.*.local
backend/.env
frontend/.env.local
*.pem
*.key
secrets/

# ══════════════════════════════════════
#  PYTHON
# ══════════════════════════════════════
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json

# ══════════════════════════════════════
#  NODE / FRONTEND
# ══════════════════════════════════════
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.vite/
.cache/
.parcel-cache/

# ══════════════════════════════════════
#  IDE & EDITORS
# ══════════════════════════════════════
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
*.code-workspace

# ══════════════════════════════════════
#  OS FILES
# ══════════════════════════════════════
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ══════════════════════════════════════
#  LOGS
# ══════════════════════════════════════
*.log
logs/
*.log.*

# ══════════════════════════════════════
#  TESTING / COVERAGE
# ══════════════════════════════════════
coverage/
.nyc_output/
test-results/
playwright-report/

# ══════════════════════════════════════
#  MISC
# ══════════════════════════════════════
