# ─────────────────────────────────────────────────────────────
# Adaptive Emergency Triage Agent — Environment Variables
# Copy this file to .env (backend) and .env.local (frontend)
# NEVER commit .env or .env.local to version control
# ─────────────────────────────────────────────────────────────

# ══════════════════════════════════════
#  BACKEND  (.env in /backend folder)
# ══════════════════════════════════════

# Google Gemini API key
# Get free key at: https://aistudio.google.com/app/apikey
# Used ONLY for NLU text extraction — never for scoring or routing
# If empty, the agent falls back to deterministic regex NLU (still works)
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI server settings
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Environment label (SANDBOX | STAGING | PRODUCTION)
ENVIRONMENT=SANDBOX

# Maximum questions per session before forced decision
MAX_QUESTIONS=9

# Risk score confidence floor below which escalation triggers (percent)
CONFIDENCE_FLOOR=55.0

# Belief entropy threshold for escalation (bits)
ENTROPY_ESCALATE_BITS=1.45

# CORS origins (comma-separated, use * for development only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Redis URL for persistent sessions (leave blank = in-memory)
REDIS_URL=

# Optional: PostgreSQL URL for audit log storage (leave blank = no DB)
DATABASE_URL=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ══════════════════════════════════════
#  FRONTEND  (.env.local in /frontend)
# ══════════════════════════════════════

# Backend API base URL
# Development: http://localhost:8000
# Production:  https://your-backend.railway.app
VITE_API_URL=http://localhost:8000

# App display name shown in browser tab
VITE_APP_NAME=TriageAI — Adaptive Emergency Triage

# Enable verbose debug panel in UI (true | false)
VITE_DEBUG_MODE=false